# Copy to .env (gitignored). Never put these in your MCP client config.

# Lead Entry API user (SingleOps -> Users -> your API user -> View API Token).
# Only used for the 4 documented routes. Leave blank if not needed.
SINGLEOPS_LEAD_USER_EMAIL=
SINGLEOPS_LEAD_USER_TOKEN=

# Capability gates — everything defaults OFF.
SINGLEOPS_ENABLE_WRITE=false
# DELETE tools (still need a typed confirm per call). Keep off outside a supervised test.
SINGLEOPS_ENABLE_DELETE=false
# Live writes per server run before the MCP refuses more (runaway guard; raise on purpose for a backfill).
SINGLEOPS_MAX_WRITES=25

# Throttle (requests per second). Undocumented API: stay gentle.
SINGLEOPS_MAX_RPS=1

# Streamable HTTP mode (npm run start:http) — for Grok and other remote agents.
# Required for --http: a long random token; clients send Authorization: Bearer <token>.
SINGLEOPS_HTTP_TOKEN=
SINGLEOPS_HTTP_HOST=127.0.0.1
SINGLEOPS_HTTP_PORT=3333
# Comma-separated browser origins allowed to call HTTP mode (agents and CLIs send none).
SINGLEOPS_HTTP_ALLOWED_ORIGINS=
